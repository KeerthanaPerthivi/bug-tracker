pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            agent{
                docker{
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            steps {
              dir('bugtracker-backend'){
              sh '''
              mkdir -p /tmp/go-build
              mkdir -p /tmp/go-mod

              export GOCACHE=/tmp/go-build
              export GOMODCACHE=/tmp/go-mod

              go test -v ./...
            '''
              }
            }
        }
    }
}